{
  "paths": {
    "data_root": "../urban-observations/data",
    "backup_root": "../urban-observations/backups"
  },
  "receiver": {
    "bind_host": "127.0.0.1",
    "port": 8766,
    "output_path": "./processing-output/observations.jsonl",
    "max_message_bytes": 25000000
  },
  "enrichment": {
    "host": "127.0.0.1",
    "port": 8770,
    "anomaly_threshold": 0.25,
    "anomaly_only": false,
    "gpu": "auto",
    "gpu_devices": "all",
    "pytorch_version": "2.7.1",
    "pytorch_index_url": "https://download.pytorch.org/whl/cu118",
    "text_model": "gpt-4o-mini",
    "vision_model": "gpt-4o-mini",
    "openai_api_key": "replace_me",
    "google_places_api_key": "replace_me",
    "openai_budget_usd": 5.0
  },
  "replay": {
    "receiver": {
      "host": "127.0.0.1",
      "port": 8766
    }
  }
}
